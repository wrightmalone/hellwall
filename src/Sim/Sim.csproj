<Project Sdk="Microsoft.NET.Sdk">
  <!--
    THE PORTABLE HALF. No Godot reference, ever: a Godot type in here fails to
    compile, which is the whole enforcement mechanism. BannedSymbols.txt adds
    the ambient-nondeterminism ban on top (clocks, System.Random, randomized
    hashing, IO, threads). Both are checked by tests/Sim.Tests/PortabilityTests.
  -->
  <PropertyGroup>
    <AssemblyName>Hellwall.Sim</AssemblyName>
    <RootNamespace>Hellwall.Sim</RootNamespace>
    <!--
      Optimized in every configuration. Godot runs the Debug build of the game,
      and an unoptimized sim runs ~2.5x slower (13.8 vs 5.4 ms/tick at 20k
      demons), which makes a debug session unplayable. The sim is tested
      headlessly, so losing step-through debugging here is cheap.
    -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Default rules ship inside the assembly: the sim does no IO. -->
    <EmbeddedResource Include="data/rules.json" LogicalName="Hellwall.Sim.rules.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hellwall.Sim.Tests" />
  </ItemGroup>
</Project>
